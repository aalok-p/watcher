# GPU Monitoring Settings
POLL_INTERVAL_SEC=3
SCREENSHOT_ENABLED=true
PORT=8000

# Oxlo AI config
OPENAI_API_KEY=your-oxlo-api-key-here
OPENAI_BASE_URL=https://api.oxlo.ai/v1
OPENAI_MODEL=deepseek-r1-8b

